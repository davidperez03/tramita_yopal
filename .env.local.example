# ============================================================
# TRAMITA YOPAL — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================


# ── Supabase (obligatorio) ───────────────────────────────────
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...


# ── OpenAI (chatbot IA) ──────────────────────────────────────
# Obtén tu clave en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...


# ── Sentry (observabilidad, opcional) ───────────────────────
# Crea un proyecto en https://sentry.io y pega el DSN aquí.
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=nombre-de-tu-org
SENTRY_PROJECT=tramita-yopal


# ── CallMeBot (notificaciones WhatsApp, opcional) ────────────
# Regístrate en https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=


# ── IndexNow (indexación en buscadores, opcional) ────────────
# Deja vacío para usar la clave por defecto o pon la tuya.
INDEXNOW_KEY=
